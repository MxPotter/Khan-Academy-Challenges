//moon
var x = 35;
var y = 35;

//star
var xPos = 330;
var yPos = 75;

draw = function() {
    background(29, 40, 115);
    fill(255, 242, 0);
    ellipse(xPos, yPos, 10, 10);
    
    //house
    fill(5, 5, 5);
    rect(50, 200, 150, 200);
    triangle(125, 150, 50, 200, 200, 200);
    
    //moon
    fill(237, 240, 158);
    ellipse(x, y, 50, 50);
    
    x ++;
    y --;
    
    //shooting star
    xPos --;
    yPos ++;
};
